# PostgreSQL asinxron ulanish (postgresql+asyncpg://user:password@host:port/dbname)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_db

# Connection Pool sozlamalari
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0

# Xavfsizlik va resurs cheklovlari
MAX_ROW_LIMIT=100
DEFAULT_ROW_LIMIT=50
QUERY_TIMEOUT_SECONDS=5.0

# Logging va Server
LOG_LEVEL=INFO
SERVER_NAME=secure-postgres-mcp